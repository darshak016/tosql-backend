# Database Connection (Optional: configure default database, or connect via the UI)
# Examples:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb
# DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_URL=sqlite:///path/to/my_database.db
DATABASE_URL=

# AI Provider Keys (Optional: Leave empty for offline intelligent demo mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model Configuration
DEFAULT_MODEL=gemini-2.5-flash

# Query Safety Limits
MAX_QUERY_ROWS=200
EXECUTION_TIMEOUT_SECONDS=15
